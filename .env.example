# Paper KB Environment Variables
# Copy this file to .env and fill in your own keys, or export them directly.

# ── Required ──

# OpenAI / OpenRouter API key (for embeddings)
# Get from: https://platform.openai.com/api-keys or https://openrouter.ai/
OPENAI_API_KEY=sk-...

# Optional: override the embedding API base URL
# Default: https://openrouter.ai/api/v1
# For native OpenAI: https://api.openai.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Alibaba DashScope API key (for Qwen chat model)
# Get from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-...

# ── Optional ──

# Feishu webhook for weekly digest push
# Create a custom bot in your Feishu group chat
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx
